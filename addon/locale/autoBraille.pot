#. Add-on summary in manifest
#: manifest.ini:summary
msgid "Auto Braille (Multi-Script Translation & Perkins Input)"
msgstr ""

#. Long description of the add-on in manifest
#: manifest.ini:description
msgid "Universal multi-script braille translation and Perkins keyboard input auto-switching for NVDA. Automatically detects Persian, Arabic, Cyrillic, Hebrew, Greek, and Devanagari alongside English, translating each script in-line on any braille display and synchronizing Perkins braille typing with the Windows keyboard layout in real time."
msgstr ""

